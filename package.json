{
	"name": "template-obsidian-plugin",
	"version": "1.0.0",
	"description": "Template for Development of Obsidian Plugin",
	"main": "src/main.js",
	"scripts": {
		"prepare": "husky",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"start": "node dist/index.js",
		"dev": "node esbuild.config.mjs",
		"test": "jest --passWithNoTests",
		"lint": "eslint src/**/*.ts",
		"format": "prettier --write \"src/**/*.{ts,json,md}\"",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [],
	"author": "stone",
	"license": "MIT",
	"devDependencies": {
		"semantic-release": "^25.0.2",
		"@semantic-release/exec": "^7.1.0",
		"@semantic-release/git": "^10.0.1",
		"@semantic-release/github": "^12.0.2",
		"@semantic-release/npm": "^13.1.3",
		"@types/jest": "^30.0.0",
		"@types/node": "^25.0.3",
		"@typescript-eslint/eslint-plugin": "8.51.0",
		"@typescript-eslint/parser": "8.51.0",
		"builtin-modules": "5.0.0",
		"esbuild": "^0.27.2",
		"husky": "^9.1.7",
		"jest": "^30.2.0",
		"lint-staged": "^16.2.7",
		"obsidian": "latest",
		"prettier": "3.7.4",
		"ts-jest": "^29.4.6",
		"tslib": "2.8.1",
		"eslint": "^9.39.2",
		"typescript": "^5.9.3"
	},
	"dependencies": {
		"date-fns": "^4.1.0",
		"winston": "^3.19.0"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/stone-home/Template-Obsidian-Plugin.git"
	},
	"lint-staged": {
		"*.tex": [
			"prettier --write",
			"textlint"
		],
		"*.{ts,js,json,md}": [
			"prettier --write"
		]
	}
}
